  <title>Hooyo apps</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f9f9f7; color: #1a1a1a; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
    .page { max-width: 480px; width: 100%; margin: 0 auto; padding: 3rem 1.5rem; text-align: center; }
    .logo { width: 72px; height: 72px; border-radius: 18px; background: #1a1a2e; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; font-size: 28px; font-weight: 700; color: #fff; letter-spacing: -1px; }
    h1 { font-size: 26px; font-weight: 600; margin-bottom: 8px; }
    .tagline { font-size: 15px; color: #666; line-height: 1.6; margin-bottom: 2.5rem; }
    .divider { width: 40px; height: 2px; background: #e0e0e0; margin: 0 auto 2.5rem; }
    .store-label { font-size: 11px; color: #999; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1rem; }
    .store-buttons { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-bottom: 1.5rem; }
    .store-btn { display: flex; align-items: center; gap: 10px; padding: 10px 20px; border-radius: 10px; border: 1px solid #e0e0e0; background: #fff; text-decoration: none; color: #1a1a1a; font-size: 14px; font-weight: 500; transition: border-color 0.15s; }
    .store-btn:hover { border-color: #aaa; }
    .web-btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px; border-radius: 10px; border: 1px solid #e0e0e0; background: #f2f2f0; text-decoration: none; color: #555; font-size: 13px; margin-bottom: 3rem; transition: border-color 0.15s; }
    .web-btn:hover { border-color: #aaa; }
    .footer { font-size: 12px; color: #bbb; }
  </style>
</head>
